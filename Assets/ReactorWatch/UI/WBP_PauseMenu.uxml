<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ReactorWatch.uss" />
    <ui:VisualElement name="pause-menu" class="overlay">
        <ui:VisualElement class="menu-box">
            <ui:Label text="PAUSED" class="menu-title" />
            <ui:Button name="pause-resume" text="Resume" class="menu-button" />
            <ui:Button name="pause-restart" text="Restart" class="menu-button" />
            <ui:Button name="pause-quit" text="Quit" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
